    {
      "parameters": {
        "jsCode": "const servers = $('Hetzner: список серверів').first().json.servers || [];\nconst rows = $input.all().map(i => i.json);\n\nlet mark = null;\ntry {\n  const t = $('Вхід: виклик з іншого флоу').first().json;\n  if (t && t.mark_name) mark = { name: String(t.mark_name), state: String(t.mark_state || ''), chat: String(t.mark_chat || '') };\n} catch (e) {}\n\nconst ZONE = 'example.com';\nconst TZ = 'Europe/Kyiv';\nconst FMT = 'yyyy-LL-dd HH:mm';\nconst nowDt = DateTime.now().setZone(TZ);\nconst now = nowDt.toFormat(FMT);\nconst INSTALL_TIMEOUT_MIN = 25;\n\nconst stateMap = {\n  running: '🟢 On', off: '🔴 Off', initializing: '🟡 Starting', starting: '🟡 Starting',\n  stopping: '🟡 Stopping', migrating: '🟡 Migrating', rebuilding: '🟡 Rebuilding', deleting: '🗑️ Deleted'\n};\nconst num = v => parseFloat(String(v === undefined || v === null ? '' : v).replace(',', '.'));\n\nconst byName = {};\nfor (const r of rows) {\n  if (r['Назва']) byName[String(r['Назва'])] = r;\n}\nconst hz = {};\nfor (const s of servers) {\n  if (String(s.name).startsWith('cvat-')) hz[s.name] = s;\n}\n\nconst out = [];\n\nfor (const name of Object.keys(hz)) {\n  const s = hz[name];\n  const t = s.server_type || {};\n  const loc = s.location || (s.datacenter && s.datacenter.location) || {};\n  const specs = String(t.name || '').toUpperCase() + ' | ' + (t.architecture || '') + ' | ' + s.primary_disk_size + ' GB | ' + (loc.network_zone || '');\n  const p = (t.prices || []).find(x => x.location === loc.name);\n  const price = p ? Math.round(num(p.price_monthly.gross) * 100) / 100 : '';\n  const ip = (s.public_net && s.public_net.ipv4 && s.public_net.ipv4.ip) || '';\n  const url = 'https://' + name + '.' + ZONE;\n  const row = byName[name];\n  const cur = row ? String(row['Стан'] || '') : '';\n  const isMarked = mark && mark.name === name;\n  const rowChat = row ? String(row['Chat'] || '') : '';\n\n  let state = stateMap[s.status] || ('⚪ ' + s.status);\n  let timedOut = false;\n  if (isMarked) {\n    state = mark.state;\n  } else if (row && cur.indexOf('Failed') >= 0) {\n    state = cur;\n  } else if (row && cur.indexOf('Installing') >= 0) {\n    const started = DateTime.fromFormat(String(row['Оновлено'] || ''), FMT, { zone: TZ });\n    const ageMin = started.isValid ? nowDt.diff(started, 'minutes').minutes : 0;\n    if (ageMin > INSTALL_TIMEOUT_MIN) {\n      state = '❌ Failed (timeout)';\n      timedOut = true;\n    } else {\n      continue;\n    }\n  }\n\n  const chat = (isMarked && mark.chat) ? mark.chat : rowChat;\n  const next = { 'Назва': name, 'Характеристики': specs, 'Стан': state, 'Ціна': price, 'IP': ip, 'URL': url, 'Chat': chat };\n  if (timedOut && chat) {\n    next.notify_space = chat;\n    next.notify_text = '⚠️ Установка ' + name + ' не завершилась за ' + INSTALL_TIMEOUT_MIN + ' хвилин (статус: ❌ Failed (timeout)). IP: ' + ip + '. Перевірте лог на сервері: /var/log/cloud-init-output.log';\n  }\n  if (row) {\n    const same = String(row['Характеристики'] || '') === specs\n      && cur === state\n      && num(row['Ціна']) === num(price)\n      && String(row['IP'] || '') === ip\n      && String(row['URL'] || '') === url\n      && rowChat === chat;\n    if (same) continue;\n    next['Оновлено'] = now;\n    next.op = 'update';\n    next.row_number = row.row_number;\n  } else {\n    next['Оновлено'] = now;\n    next.op = 'append';\n  }\n  out.push(next);\n}\n\nfor (const name of Object.keys(byName)) {\n  if (!name.startsWith('cvat-') || hz[name]) continue;\n  const row = byName[name];\n  const cur = String(row['Стан'] || '');\n  if (cur.indexOf('Delete') >= 0) continue;\n  out.push({\n    op: 'update',\n    row_number: row.row_number,\n    'Назва': name,\n    'Характеристики': row['Характеристики'] || '',\n    'Стан': '🗑️ Deleted',\n    'Ціна': row['Ціна'] === undefined ? '' : row['Ціна'],\n    'IP': row['IP'] || '',\n    'URL': row['URL'] || '',\n    'Chat': row['Chat'] || '',\n    'Оновлено': now\n  });\n}\n\nreturn out.map(r => ({ json: r }));"
      },
