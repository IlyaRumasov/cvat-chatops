      "id": "97e05873-7016-4c69-96d2-11a948c1edf7",
      "name": "Таблиця: прочитати рядки",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        912,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
